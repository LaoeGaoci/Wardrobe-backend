{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "wardrobe-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wardrobe-db",
      "database_id": "b6bc17d9-781a-41dd-a48d-548da5ca9922"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "wardrobe-images"
    }
  ],

  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "noreply@email.laoegaoci.win"
      ]
    }
  ],

  "vars": {
    "EMAIL_FROM": "noreply@email.laoegaoci.win"
  },

  "routes": [
    {
      "pattern": "api.laoegaoci.win",
      "custom_domain": true
    }
  ]
}